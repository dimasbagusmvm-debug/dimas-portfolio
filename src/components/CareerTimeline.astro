---
import { career, careerYears } from '../data/site';
import { ui, type Locale } from '../i18n';
interface Props { kicker: string; locale: Locale }
const { kicker, locale } = Astro.props;
const total = career.reduce((s, c) => s + c.months, 0);
---
<div class="career">
  <p class="kicker">{kicker}</p>
  <div class="career-bar" role="img" aria-label={career.map((c) => `${c.name}: ${c.months} ${ui[locale].months}`).join(', ')}>
    {career.map((c) => <i style={`flex:${c.months / total};background:${c.color}`} />)}
  </div>
  <div class="career-axis" aria-hidden="true">
    {careerYears.map((y) => <span style={y.at === 100 ? 'right:0' : `left:${y.at}%`}>{y.year}</span>)}
  </div>
  <ul class="legend">
    {career.map((c) => <li><i style={`background:${c.color}`} />{c.name}</li>)}
  </ul>
</div>
