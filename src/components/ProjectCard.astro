---
import { Image } from 'astro:assets';
import { img, type Project } from '../data/projects';
import { localePath, projectGroup, ui, type Locale } from '../i18n';
interface Props { project: Project; locale: Locale }
const { project: p, locale } = Astro.props;
const total = projectGroup(locale, p.group).length;
---
<a class="pcard" href={localePath(locale, `/projects/${p.slug}/`)} style={`--acc:${p.accent}`}>
  <div class="thumb">
    <Image src={img(p.opener.cover.file)} alt="" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 20rem" style={p.opener.cover.position ? `object-position:${p.opener.cover.position}` : undefined} />
    <span class="num">{p.num} / {String(total).padStart(2, '0')}</span>
  </div>
  <div class="body">
    <p class="kicker">{p.card.kicker}</p>
    <h3 set:html={p.card.hook} />
    <p>{p.card.company}</p>
    <p>{p.card.role}</p>
    <span class="go">{ui[locale].readStory}</span>
  </div>
</a>
