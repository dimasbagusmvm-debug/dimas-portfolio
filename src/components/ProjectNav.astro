---
import { getProjects, localePath, ui, type Locale } from '../i18n';
import type { Project } from '../data/projects';
interface Props { project: Project; position: 'top' | 'bottom'; locale: Locale }
const { project, position, locale } = Astro.props;
const projects = getProjects(locale);
const next = projects[(projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length];
const t = ui[locale];
---
{position === 'top' ? (
  <nav class="crumbs" aria-label="Project navigation">
    <a href={localePath(locale, '/#projects')}>{t.allProjects}</a>
    <span>{project.num} / {String(projects.length).padStart(2, '0')}</span>
  </nav>
) : (
  <nav class="chapter-nav" aria-label="Project navigation">
    <a href={localePath(locale, '/#projects')}>{t.allProjects}</a>
    <a class="next" href={localePath(locale, `/projects/${next.slug}/`)} style={`--acc:${next.accent}`}>{t.next}: {next.short} →</a>
  </nav>
)}
