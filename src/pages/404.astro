---
import Base from '../layouts/Base.astro';
import Slide from '../components/Slide.astro';
import { localePath, ui } from '../i18n';
// One 404 for both languages: English first, with a way back to each home page.
const t = ui.en.notFound;
---
<Base locale="en" title={`${t.title} · Dimas Bagus Ginta P`} description={t.sub} noindex>
  <Slide kicker="404" hook={t.hook} hookIsH1 sub={t.sub}>
    <div class="links">
      <a class="primary" href={localePath('en', '/#projects')}>{ui.en.allProjects}</a>
      <a href={localePath('id', '/#projects')} lang="id">{ui.id.allProjects}</a>
    </div>
  </Slide>
</Base>
