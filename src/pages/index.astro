---
import Base from '../layouts/Base.astro';
import Slide from '../components/Slide.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { projects } from '../data/projects';
import { site, heroStats, experience, education, toolkit, url } from '../data/site';
const accent = Object.fromEntries(projects.map((p) => [p.slug, p.accent]));
---
<Base ogImage={url('/og/home.png')} title={`${site.name} · ${site.title}`} description="Nine years building digital products in Indonesia, from SME SaaS and telecom fintech to coal mining and AI-enabled ERP.">
  <Slide class="hero" kicker="Product portfolio" hook="I turn messy operations into products people <em>actually use.</em>"
    sub="Nine years building digital products in Indonesia, from SME SaaS and telecom fintech to coal mining and AI-enabled ERP. Computer Science by training, translator between executives, engineers and people in the field by habit.">
    <h1 slot="before-sub">{site.name} · {site.title}</h1>
    <ContactLinks pdf projects />
    <div class="overview">
      <p class="kicker">The numbers, up front</p>
      <div class="hstats">
        {heroStats.map((s) => (
          <a class="hstat" href={url(`/projects/${s.slug}/`)} style={`--acc:${accent[s.slug]}`}>
            <b set:html={s.big} /><span>{s.caption}</span><small>{s.small}</small>
          </a>
        ))}
      </div>
    </div>
    <CareerTimeline />
  </Slide>

  <section class="projects" id="projects">
    <p class="kicker">Projects</p>
    <h2>Pick a story</h2>
    <p class="lead">Five products across mining, fintech, AI and SME SaaS. Open any one for the full story.</p>
    <div class="cards">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </section>

  <section class="back">
    <h2>Experience</h2>
    <ul class="exp">
      {experience.map((e) => <li><span class="yr">{e.dates}</span><div><b>{e.role}</b><span class="r">{e.line}</span></div></li>)}
    </ul>
    <div class="cols2">
      <div>
        <h2>Education & certifications</h2>
        <ul class="plain">{education.map((e) => <li><b>{e.title}</b><span>{e.sub}</span></li>)}</ul>
      </div>
      <div>
        <h2>Toolkit</h2>
        <ul class="plain">{toolkit.map((e) => <li><b>{e.title}</b><span>{e.sub}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <Slide class="end" kicker="What’s next" hook="Got a messy problem? <em>Let’s talk.</em>" sub="Open to product leadership roles in SaaS across industries, remote or international.">
    <ContactLinks />
  </Slide>
  <footer>{site.name} · {site.location}</footer>
</Base>
